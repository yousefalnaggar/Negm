DATABASE_URL="postgresql://store:store_dev_password@localhost:5434/store"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
# Product images. Leave the R2_* lines empty to store uploads in public/uploads (dev only),
# with MEDIA_BASE_URL="/uploads". With R2: fill all four and set MEDIA_BASE_URL to the
# bucket's public URL (r2.dev for testing, https://cdn.<domain> in production).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
MEDIA_BASE_URL="/uploads"
# Used once by `npm run db:seed` to create the first admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
